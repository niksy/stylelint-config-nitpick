{
  "name": "stylelint-config-nitpick",
  "version": "12.0.1",
  "description": "Stylelint config for my projects.",
  "license": "MIT",
  "author": "Ivan Nikolić <niksy5@gmail.com> (http://ivannikolic.com)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "files": [
    "index.js",
    "scss.js",
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint '{index,scss,test/**/*}.js'",
    "prepare": "if [[ -x \"$(command -v husky)\" ]]; then husky; fi",
    "postpublish": "GITHUB_TOKEN=$GITHUB_RELEASE_TOKEN github-release-from-changelog",
    "prerelease": "npm run lint",
    "release": "np --no-release-draft",
    "pretest": "stylelint-find-new-rules test/fixtures/all-rules.js",
    "test": "mocha 'test/**/*.js'",
    "test:watch": "npm test -- --watch",
    "version": "version-changelog CHANGELOG.md && changelog-verify CHANGELOG.md && git add CHANGELOG.md"
  },
  "dependencies": {
    "postcss-scss": "^4.0.9",
    "stylelint-number-z-index-constraint": "^3.2.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "stylelint-selector-pseudo-class-lvhfa": "^3.2.0",
    "stylelint-value-list-box-shadow-inset-first": "^3.3.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "changelog-verify": "^1.1.2",
    "eslint": "^9.39.1",
    "eslint-config-nitpick": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "github-release-from-changelog": "^2.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "lodash": "^4.18.1",
    "lodash.difference": "^4.5.0",
    "lodash.without": "^4.4.0",
    "mocha": "^10.8.2",
    "np": "^10.3.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-find-new-rules": "^6.1.0",
    "version-changelog": "^3.1.1"
  },
  "peerDependencies": {
    "stylelint": "^17.0.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "nitpick",
    "stylelint",
    "stylelintconfig"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niksy/stylelint-config-nitpick.git"
  },
  "bugs": {
    "url": "https://github.com/niksy/stylelint-config-nitpick/issues"
  },
  "homepage": "https://github.com/niksy/stylelint-config-nitpick#readme"
}
